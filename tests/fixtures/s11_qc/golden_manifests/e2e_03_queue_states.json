{
  "schema_version": 1,
  "manifest_id": "e2e_03_queue_states",
  "scenario": {
    "id": "e2e-03-queue-states",
    "title": "Review queue state lifecycle",
    "source": "lane-C E2E_SCENARIOS (queue states) + T03F recheck resolution + GAP-8 fail-closed",
    "description": "Review Queue surface all QCItem statuses: items are created open, actionable statuses are open/acknowledged, and items move to terminal statuses (resolved with fresh evidence / dismissed) without ever reopening. Unfixed items stay open."
  },
  "policy_ref": {
    "policy_id": "s11-qc-thresholds-v1",
    "policy_content_hash": "de215c6243e1c6bf300e2bfa1c8024fbda6d0358ecf3cad1730781e37419ea24",
    "policy_source": "tests/fixtures/s11_golden/qc_thresholds.json",
    "binding": "read-only consumption — this manifest carries NO threshold values, only the frozen policy identity"
  },
  "consumes": {
    "media": [
      {
        "scenario": "two_scene_source",
        "builder": "build_two_scene_source",
        "manifest": "tests/fixtures/s11_qc/media_manifests/two_scene_source.json"
      }
    ],
    "seed": [
      "seed_workspace_project_video",
      "seed_all_reason_codes"
    ],
    "orchestrator": {
      "module": "app.services.qc_checks.orchestrator",
      "entry": "run_full_check_set"
    },
    "read_authority": {
      "module": "app.persistence.qc_check_runs",
      "entry": "check_run_readiness"
    }
  },
  "creation_path": "T06A1 seed_all_reason_codes on two_scene_source (every item status_at_create=open)",
  "expected_qc_items": [
    {
      "reason_code": "trajectory_drift",
      "severity": "warning",
      "status_at_create": "open",
      "expected_count": 1,
      "expected_status_after": "acknowledged"
    },
    {
      "reason_code": "cut_drift",
      "severity": "warning",
      "status_at_create": "open",
      "expected_count": 1,
      "expected_status_after": "resolved",
      "resolution": "recheck_fresh_evidence"
    },
    {
      "reason_code": "contact_break",
      "severity": "warning",
      "status_at_create": "open",
      "expected_count": 1,
      "expected_status_after": "dismissed"
    },
    {
      "reason_code": "identity_drift",
      "severity": "warning",
      "status_at_create": "open",
      "expected_count": 1,
      "expected_status_after": "open",
      "note": "unfixed item stays open — recheck with unchanged evidence does not resolve"
    },
    {
      "reason_code": "audio_missing",
      "severity": "warning",
      "status_at_create": "open",
      "expected_count": 1,
      "expected_status_after": "resolved",
      "resolution": "recheck_fresh_evidence"
    }
  ],
  "expected_total_count": 5,
  "expected_readiness": {
    "before": {
      "status": "not_run",
      "run_state": "never_run",
      "check_state": "no completed QC check run"
    },
    "after": {
      "status": "ready",
      "run_state": "completed",
      "expected_blocker_codes": [],
      "note": "queue-state walk uses warning-only baseline; no blocker appears"
    }
  },
  "queue_semantics": {
    "actionable_statuses": [
      "open",
      "acknowledged"
    ],
    "terminal_statuses": [
      "resolved",
      "dismissed"
    ],
    "reopen_allowed": false,
    "reopen_rule": "GAP-8 fail-closed: a terminally resolved/dismissed item can never be reopened by a later run",
    "navigation": "Review Queue opens the first issue frame on navigation"
  }
}